# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/defitracker

# App Config
APP_URL=http://localhost:3002
PORT=3002
JWT_SECRET=CHANGE_ME_mindestens_32_zeichen_zufaellig

# SMTP Config (for emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: Bootstrap Roles (comma-separated emails)
OWNER_EMAILS=
ADMIN_EMAILS=

# Optional: Avalanche RPC for Benqi Oracle
AVALANCHE_RPC_URL=

# Offener Betrieb ohne Anmeldung.
# Leer oder nicht gesetzt = normale Anmeldung ueber den Sitzungs-Cookie.
# Gesetzt = jeder Besucher gilt als dieses Konto. Nur fuer eine Instanz,
# die bewusst oeffentlich stehen soll.
OPEN_ACCESS_ACCOUNT_ID=

# Datenbank. Ohne Default im Compose — beide Werte muessen hier stehen.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
